{
  "name": "codex-imagegen-mcp",
  "version": "0.2.1",
  "description": "MCP server + Agent Skill that brings OpenAI Codex's image generation to your coding tools, with a one-command installer for opencode, Claude Code, Codex, Cursor, VS Code, Gemini CLI and 20 more. Runs on your ChatGPT plan with no API key.",
  "license": "Apache-2.0",
  "author": "Shalom Obongo (https://github.com/ShalomObongo)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShalomObongo/codex-imagegen-mcp.git"
  },
  "homepage": "https://github.com/ShalomObongo/codex-imagegen-mcp#readme",
  "bugs": {
    "url": "https://github.com/ShalomObongo/codex-imagegen-mcp/issues"
  },
  "type": "module",
  "bin": {
    "codex-imagegen-mcp": "dist/src/cli.js"
  },
  "main": "dist/src/server/index.js",
  "files": [
    "dist/src",
    "skill",
    "docs/*.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/src/cli.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 \"dist/test/**/*.test.js\"",
    "start": "node dist/src/cli.js serve",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "image-generation",
    "image-editing",
    "gpt-image",
    "codex",
    "openai-codex",
    "chatgpt",
    "opencode",
    "claude-code",
    "cursor",
    "agent-skills",
    "installer",
    "gemini-cli",
    "github-copilot",
    "vscode",
    "claude-desktop"
  ],
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "jpeg-js": "^0.4.4",
    "jsonc-parser": "^3.3.1",
    "pngjs": "^7.0.0",
    "smol-toml": "^1.9.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pngjs": "^6.0.5",
    "typescript": "^7.0.2"
  }
}
